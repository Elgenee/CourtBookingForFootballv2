@model List<CourtBookingSystem.Models.Booking>
@{
    ViewData["Title"] = "Today's Bookings";
    var target = (DateTime)ViewBag.TargetDate;
    string formatTime(TimeSpan t) => PhilippineTime.FormatTime(t);
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h5 class="card-title mb-0"><i class="fas fa-calendar-day mr-2"></i>@target.ToString("dddd, MMMM d, yyyy") <span class="badge badge-secondary ml-2">@Model.Count</span></h5>
        <form method="get" asp-action="Today" class="form-inline">
            <label class="text-muted small mr-2 mb-0">Date</label>
            <input type="date" name="date" value="@target.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-outline-primary ml-2">Go</button>
            <a asp-controller="WalkIn" asp-action="Create" class="btn btn-sm btn-primary ml-2">
                <i class="fas fa-plus mr-1"></i>New Walk-In
            </a>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-muted text-center">No bookings for this day.</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Time</th>
                        <th>Field</th>
                        <th>Customer</th>
                        <th>Booking Status</th>
                        <th>Payment</th>
                        <th class="text-right">Total</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model)
                {
                    var pay = b.Payments.OrderByDescending(p => p.Id).FirstOrDefault();
                    var payStatus = pay?.PaymentStatus;
                    var canApprove = b.BookingStatus is BookingStatus.Pending or BookingStatus.ForApproval;
                    var canComplete = b.BookingStatus == BookingStatus.Confirmed;
                    var canCancel = b.BookingStatus is BookingStatus.Pending or BookingStatus.ForApproval or BookingStatus.PartiallyPaid or BookingStatus.Confirmed;
                    <tr>
                        <td>
                            <strong>@formatTime(b.StartTime)</strong>
                            <div class="small text-muted">to @formatTime(b.EndTime)</div>
                        </td>
                        <td>@b.Court?.CourtName<br /><small class="text-muted">@b.Court?.SportType</small></td>
                        <td>
                            <div class="text-monospace small">@b.BookingReferenceNo</div>
                            <strong>@b.CustomerName</strong><br /><small class="text-muted">@b.CustomerMobile</small>
                        </td>
                        <td><span class="status-badge status-@b.BookingStatus">@b.BookingStatus</span></td>
                        <td>
                            @if (pay != null)
                            {
                                <span class="status-badge payment-@pay.PaymentStatus">@pay.PaymentStatus</span>
                                <div class="small text-muted">@pay.PaymentMethod</div>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-right">@b.TotalAmount.ToString("0.00")</td>
                        <td class="text-right">
                            @if (canApprove)
                            {
                                <form asp-action="ApprovePayment" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve payment and confirm booking">
                                        <i class="fas fa-check mr-1"></i>Approve
                                    </button>
                                </form>
                            }
                            @if (canComplete)
                            {
                                <form asp-action="Complete" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-info" title="Mark completed">
                                        <i class="fas fa-flag-checkered mr-1"></i>Complete
                                    </button>
                                </form>
                            }
                            @if (canCancel)
                            {
                                <form asp-action="Cancel" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this booking?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel booking">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </form>
                            }
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary" title="View details" data-testid="staff-today-details-link-@b.Id">
                                    <i class="fas fa-eye"></i>
                                </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>
