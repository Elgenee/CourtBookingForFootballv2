@* Staff Bookings list — reuses the Admin BookingFilterViewModel and mirrors the
   Admin/Views/Bookings/Index.cshtml layout. Differs only in the action links
   (Staff-area Details) so Admin's view is left untouched. *@
@model CourtBookingSystem.Areas.Admin.ViewModels.BookingFilterViewModel
@{
    ViewData["Title"] = "Bookings";
    string formatTime(TimeSpan t) => PhilippineTime.FormatTime(t);
}

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-filter mr-2"></i>Filters</h5></div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="form-row">
            <div class="form-group col-md-2">
                <label asp-for="FromDate" class="small">From</label>
                <input asp-for="FromDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label asp-for="ToDate" class="small">To</label>
                <input asp-for="ToDate" type="date" class="form-control form-control-sm" />
            </div>
            <div class="form-group col-md-2">
                <label asp-for="CourtId" class="small">Court</label>
                <select asp-for="CourtId" class="form-control form-control-sm">
                    <option value="">All courts</option>
                    @foreach (var c in Model.Courts) { <option value="@c.Id">@c.CourtName</option> }
                </select>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="Sport" class="small">Sport</label>
                <select asp-for="Sport" class="form-control form-control-sm" asp-items="Html.GetEnumSelectList<SportType>()">
                    <option value="">All sports</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="Status" class="small">Status</label>
                <select asp-for="Status" class="form-control form-control-sm" asp-items="Html.GetEnumSelectList<BookingStatus>()">
                    <option value="">Any status</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="Search" class="small">Search</label>
                <input asp-for="Search" type="text" class="form-control form-control-sm" placeholder="Ref / name / email" />
            </div>
            <div class="form-group col-12 text-right mb-0">
                <a asp-action="Index" class="btn btn-link btn-sm">Reset</a>
                <button type="submit" class="btn btn-primary btn-sm" data-testid="staff-bookings-filter-apply"><i class="fas fa-search mr-1"></i>Apply</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">
            <i class="fas fa-list mr-2"></i>Results <span class="badge badge-secondary ml-2" data-testid="staff-bookings-count">@Model.Results.Count</span>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.Results.Any())
        {
            <div class="p-4 text-muted text-center">No bookings match your filters.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0" data-testid="staff-bookings-table">
                    <thead class="thead-light">
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Court</th>
                            <th>Sport</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th class="text-right">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var b in Model.Results)
                    {
                        var pay = b.Payments.OrderByDescending(p => p.Id).FirstOrDefault();
                        <tr data-testid="staff-booking-row-@b.Id">
                            <td class="text-monospace">@b.BookingReferenceNo</td>
                            <td>
                                @b.CustomerName<br />
                                <small class="text-muted">@b.CustomerMobile</small>
                            </td>
                            <td>@b.Court?.CourtName</td>
                            <td><small class="text-muted">@b.Court?.SportType</small></td>
                            <td>@b.BookingDate.ToString("MMM d, yyyy")</td>
                            <td>@formatTime(b.StartTime) – @formatTime(b.EndTime)</td>
                            <td><span class="status-badge status-@b.BookingStatus">@b.BookingStatus</span></td>
                            <td>
                                @if (pay != null)
                                {
                                    <div>@pay.PaymentMethod</div>
                                    <span class="status-badge payment-@pay.PaymentStatus">@pay.PaymentStatus</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-right">@b.TotalAmount.ToString("0.00")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary" data-testid="staff-booking-details-link-@b.Id" title="View details">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.Results.Count >= 200)
            {
                <div class="p-2 text-muted small text-center">Showing first 200 results. Refine your filters to narrow down.</div>
            }
        }
    </div>
</div>
