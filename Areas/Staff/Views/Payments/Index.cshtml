@model IEnumerable<CourtBookingSystem.Models.Payment>
@{ ViewData["Title"] = "Pending Payments"; }

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-money-check-alt mr-2"></i>Pending Verification (@Model.Count())</h5></div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-muted text-center">All payments are verified. Nothing pending.</div>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Booking</th><th>Customer</th><th>Method</th><th>Amount</th><th>Status</th><th>Proof</th><th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="text-monospace small">@p.Booking?.BookingReferenceNo</div>
                            <small class="text-muted">@p.Booking?.Court?.CourtName · @p.Booking?.BookingDate.ToString("MMM d")</small>
                        </td>
                        <td>@p.Booking?.CustomerName<br /><small class="text-muted">@p.Booking?.CustomerMobile</small></td>
                        <td>@p.PaymentMethod</td>
                        <td><strong>@p.Amount.ToString("0.00")</strong></td>
                        <td><span class="status-badge payment-@p.PaymentStatus">@p.PaymentStatus</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ProofImagePath))
                            {
                                <img src="/@p.ProofImagePath" alt="Proof" class="proof-thumbnail"
                                     data-toggle="modal" data-target="#proofModal"
                                     data-src="/@p.ProofImagePath"
                                     data-ref="@p.Booking?.BookingReferenceNo" />
                            }
                            else if (p.PaymentMethod == PaymentMethod.GCash)
                            {
                                <span class="text-muted small"><i class="fas fa-camera-slash"></i> none</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-right">
                            <form asp-action="Approve" asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success" title="Verify"><i class="fas fa-check mr-1"></i>Verify</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Reject this payment?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject"><i class="fas fa-times"></i></button>
                            </form>
                                <a asp-area="Staff" asp-controller="Bookings" asp-action="Details" asp-route-id="@p.BookingId"
                                   class="btn btn-sm btn-outline-primary" title="View booking details"
                                   data-testid="staff-payment-details-link-@p.Id">
                                    <i class="fas fa-eye"></i>
                                </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    </div>
</div>

<partial name="_ProofModal" />
