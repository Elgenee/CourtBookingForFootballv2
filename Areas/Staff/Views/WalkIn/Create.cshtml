@model CourtBookingSystem.Areas.Staff.ViewModels.WalkInFormViewModel
@using CourtBookingSystem.Models.Enums
@{
    ViewData["Title"] = "Walk-In Booking";
    var minDate = PhilippineTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
    var maxDate = PhilippineTime.Today.AddYears(5).ToString("yyyy-MM-dd");
    // Same slots endpoint used by Customer Booking — single source of truth.
    var slotsUrl = Url.Action("GetSlots", "Bookings", new { area = "" });
}

@section Styles {
    <style>
        #walkInForm .slot-btn.slot-added { background: var(--campo-green); color: #fff; opacity: 1; }
        #selectedBookings { max-height: 45vh; overflow-y: auto; }
        @@media (max-width: 991.98px) { #selectedBookings { max-height: none; } }
    </style>
}

<form asp-action="Create" method="post" id="walkInForm" data-slots-url="@slotsUrl" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="UseSlotSelection" value="true" />
    <input type="hidden" asp-for="SubmissionId" />
    <div id="selectedSlotInputs"></div>

    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="row">
        <!-- LEFT: Selection -->
        <div class="col-lg-7">
            <div class="card booking-card mb-3">
                <div class="card-header">
                    <i class="fas fa-futbol mr-2"></i>1. Choose field &amp; time
                </div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-7">
                            <label asp-for="CourtId"></label>
                            <select asp-for="CourtId" class="form-control" id="CourtId" data-testid="walkin-court-select">
                                @foreach (var court in Model.Courts)
                                {
                                    <option value="@court.Id" data-sport="@court.SportType" data-name="@court.CourtName" data-group="@court.CourtGroupId" data-full="@court.IsFullCourt.ToString().ToLowerInvariant()">
                                        @court.CourtName — @court.SportType
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="CourtId" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-5">
                            <label asp-for="DurationHours"></label>
                            <select asp-for="DurationHours" class="form-control" id="DurationHours" data-testid="walkin-duration-select">
                                @for (var hours = 1; hours <= 8; hours++)
                                {
                                    <option value="@hours">@(hours == 1 ? "1 hour" : $"{hours} hours")</option>
                                }
                            </select>
                            <span asp-validation-for="DurationHours" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="BookingDate"></label>
                        <input asp-for="BookingDate" type="date" class="form-control" id="BookingDate"
                               min="@minDate" max="@maxDate" data-testid="walkin-date-input" />
                        <span asp-validation-for="BookingDate" class="text-danger small"></span>
                        <small class="form-text text-muted">Choose the operating date. For an early-morning booking today, select yesterday. Past slots cannot be booked.</small>
                    </div>

                    <div class="form-group">
                        <label>Available Slots</label>
                        <div id="slotsContainer" data-testid="walkin-slots-container">
                            <div class="text-muted small">Pick a field, date, and duration to see available slots.</div>
                        </div>
                        <input type="hidden" asp-for="StartTime" id="StartTime" />
                        <span asp-validation-for="StartTime" class="text-danger small d-block mt-1"></span>
                    </div>
                    <button type="button" class="btn btn-outline-primary" id="addToBookingBtn" data-testid="walkin-add-btn" disabled>
                        <i class="fas fa-plus mr-2"></i>Add to Booking
                    </button>
                    <div id="selectionMessage" class="small mt-2" role="status" aria-live="polite"></div>
                </div>
            </div>

            <div class="card booking-card mb-3">
                <div class="card-header"><i class="fas fa-user mr-2"></i>2. Customer details</div>
                <div class="card-body">
                    <div class="form-row">
                        <div class="form-group col-md-7">
                            <label asp-for="CustomerName"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Walk-in customer name" data-testid="walkin-customer-name" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-md-5">
                            <label asp-for="CustomerMobile"></label>
                            <input asp-for="CustomerMobile" class="form-control" placeholder="09xx" data-testid="walkin-customer-mobile" />
                            <span asp-validation-for="CustomerMobile" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerEmail"></label>
                        <input asp-for="CustomerEmail" class="form-control" placeholder="Optional — leave blank if none" data-testid="walkin-customer-email" />
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Notes"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Anything to note?" data-testid="walkin-notes"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card booking-card mb-3">
                <div class="card-header"><i class="fas fa-credit-card mr-2"></i>3. Payment method</div>
                <div class="card-body">
                    <div class="payment-options">
                        <label class="payment-option">
                            <input type="radio" asp-for="PaymentMethod" value="@((int)PaymentMethod.Cash)" data-testid="walkin-payment-cash" />
                            <div class="payment-option-card">
                                <i class="fas fa-money-bill-wave"></i>
                                <strong>Cash</strong>
                                <small class="text-muted">Auto-verified at counter</small>
                            </div>
                        </label>
           @*              <label class="payment-option">
                            <input type="radio" asp-for="PaymentMethod" value="@((int)PaymentMethod.GCash)" data-testid="walkin-payment-gcash" />
                            <div class="payment-option-card">
                                <i class="fas fa-mobile-screen-button"></i>
                                <strong>GCash (Manual)</strong>
                                <small class="text-muted">Mark Submitted, verify later</small>
                            </div>
                        </label> *@
                    </div>
                    <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- RIGHT: Summary -->
        <div class="col-lg-5">
            <div class="card booking-summary sticky-top" style="top: 1rem;">
                <div class="card-header"><i class="fas fa-receipt mr-2"></i>Booking Summary</div>
                <div class="card-body">
                    <h2 class="h6">Selected Bookings</h2>
                    <div id="selectedBookings" data-testid="walkin-selected-bookings" aria-live="polite"></div>
                    <hr />
                    <dl class="summary-list">
                        <dt>Total Bookings</dt>
                        <dd id="summaryCount" data-testid="walkin-summary-count">0</dd>
                        <dt>Total Hours</dt>
                        <dd id="summaryDuration" data-testid="walkin-summary-duration">0 hours</dd>
                    </dl>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="font-weight-bold">Grand Total</span>
                        <span class="summary-total" id="summaryTotal" data-testid="walkin-summary-total">₱0.00</span>
                    </div>
                    <small class="text-muted">Availability and pricing are checked again when you submit.</small>
                    <button type="submit" class="btn btn-primary btn-block btn-lg mt-3" id="submitWalkInBtn" data-testid="walkin-submit-btn" disabled>
                        <i class="fas fa-check mr-2"></i>Create Walk-In Bookings
                    </button>
                    <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index" class="btn btn-link btn-block">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="application/json" id="walkInSelectionData">@Json.Serialize(Model.Slots.Select(slot => new {
        courtId = slot.CourtId,
        operatingDate = slot.BookingDate?.ToString("yyyy-MM-dd"),
        startTime = slot.StartTime?.ToString(@"hh\:mm\:ss"),
        durationHours = slot.DurationHours,
        startDate = slot.StartDateTime?.ToString("yyyy-MM-dd"),
        endDate = slot.EndDateTime?.ToString("yyyy-MM-dd"),
        endTime = slot.EndDateTime?.ToString("HH:mm:ss"),
        label = slot.StartTime.HasValue && slot.EndDateTime.HasValue
            ? $"{PhilippineTime.FormatTime(slot.StartTime.Value)} – {PhilippineTime.FormatTime(slot.EndDateTime.Value.TimeOfDay)}" : "Invalid time",
        courtName = slot.CourtName,
        sport = slot.Sport,
        groupId = Model.Courts.FirstOrDefault(c => c.Id == slot.CourtId)?.CourtGroupId,
        isFullCourt = Model.Courts.FirstOrDefault(c => c.Id == slot.CourtId)?.IsFullCourt ?? false,
        totalAmount = slot.TotalAmount,
        rateType = slot.RateType,
        error = slot.Error
    }))</script>
    <script src="~/js/staff-walkin.js" asp-append-version="true"></script>
}
