@model CourtBookingSystem.Areas.Admin.ViewModels.BusinessHoursViewModel
@{ ViewData["Title"] = "Business Hours"; }

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-clock mr-2"></i>Operating Hours</h5></div>
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body p-0">
            <div asp-validation-summary="All" class="alert alert-danger m-3 mb-0" role="alert"></div>
            <div class="table-responsive"> 
            <table class="table mb-0">
                <thead class="thead-light">
                    <tr><th style="width: 25%;">Day</th><th>Open</th><th>Close</th><th class="text-center">Closed All Day</th></tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Days.Count; i++)
                {
                    <tr>
                        <td class="align-middle"><strong>@Model.Days[i].DayOfWeek</strong></td>
                        <td>
                            <input type="hidden" asp-for="Days[i].Id" />
                            <input type="hidden" asp-for="Days[i].DayOfWeek" />
                            <input type="time" asp-for="Days[i].OpenTime" class="form-control form-control-sm" />
                        </td>
                        <td>
                            <input type="time" asp-for="Days[i].CloseTime" class="form-control form-control-sm" />
                        </td>
                        <td class="text-center align-middle">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" asp-for="Days[i].IsClosed" class="custom-control-input" id="IsClosed_@i" />
                                <label class="custom-control-label" for="IsClosed_@i">&nbsp;</label>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        </div>
        <div class="card-footer text-right">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save Hours</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
