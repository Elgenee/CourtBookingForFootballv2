@model IEnumerable<CourtBookingSystem.Models.CourtGroup>
@{ ViewData["Title"] = "Court Groups"; }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0"><i class="fas fa-object-group mr-2"></i>Court Groups <span class="badge badge-secondary ml-2">@Model.Count()</span></h5>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus mr-1"></i>New Court Group</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-muted text-center">
                No court groups yet. Use a group to model courts that share the same physical playing area
                (e.g. a convertible Basketball / Pickleball court).
            </div>
        }
        else
        {
            <div class="table-responsive">    
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Members</th>
                        <th>Description</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var g in Model)
                {
                    <tr class="@(g.IsActive ? "" : "text-muted")">
                        <td><code>@g.GroupCode</code></td>
                        <td><strong>@g.GroupName</strong></td>
                        <td>
                            @if (g.Courts.Any())
                            {
                                @foreach (var c in g.Courts)
                                {
                                    <span class="badge badge-pill @(c.IsFullCourt ? "badge-primary" : "badge-light border")" title="@(c.IsFullCourt ? "Full Court" : "Split Court")">
                                        @c.CourtName
                                        @if (c.IsFullCourt) {<i class="fas fa-expand-arrows-alt ml-1"></i>}
                                    </span>
                                }
                            }
                            else { <span class="text-muted small">— no courts assigned —</span> }
                        </td>
                        <td><small class="text-muted">@(g.Description ?? "")</small></td>
                        <td>
                            @if (g.IsActive) {<span class="text-success"><i class="fas fa-check"></i></span>}
                            else {<span class="text-muted"><i class="fas fa-times"></i></span>}
                        </td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary" data-testid="court-group-edit-btn-@g.Id"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this group? Member courts will become independent (no sharing).');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" data-testid="court-group-delete-btn-@g.Id"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    </div>
    <div class="card-footer text-muted small">
        <i class="fas fa-info-circle mr-1"></i>
        Full Court members (<i class="fas fa-expand-arrows-alt"></i>) block every sibling when booked.
        Split Court members only block the Full Court(s) of their group.
    </div>
</div>
