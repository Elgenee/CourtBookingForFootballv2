@model CourtBookingSystem.Areas.Admin.ViewModels.BookingPricingIndexViewModel
@{
    ViewData["Title"] = "Pricing";
}

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-tags mr-2"></i>Add Field Pricing Rule</h5>
    </div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <label asp-for="NewRule.CourtId"></label>
                    <select asp-for="NewRule.CourtId" class="form-control">
                        <option value="">Choose field</option>
                        @foreach (var court in Model.Courts)
                        {
                            <option value="@court.Id">@court.CourtName</option>
                        }
                    </select>
                    <span asp-validation-for="NewRule.CourtId" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="NewRule.Name"></label>
                    <input asp-for="NewRule.Name" class="form-control" />
                    <span asp-validation-for="NewRule.Name" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="NewRule.StartTime"></label>
                    <input asp-for="NewRule.StartTime" type="time" class="form-control" />
                    <span asp-validation-for="NewRule.StartTime" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="NewRule.EndTime"></label>
                    <input asp-for="NewRule.EndTime" type="time" class="form-control" />
                    <span asp-validation-for="NewRule.EndTime" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="NewRule.HourlyRate"></label>
                    <input asp-for="NewRule.HourlyRate" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="NewRule.HourlyRate" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-3">
                    <label asp-for="NewRule.EffectiveStartDate"></label>
                    <input asp-for="NewRule.EffectiveStartDate" type="date" class="form-control" />
                    <span asp-validation-for="NewRule.EffectiveStartDate" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="NewRule.EffectiveEndDate"></label>
                    <input asp-for="NewRule.EffectiveEndDate" type="date" class="form-control" />
                    <span asp-validation-for="NewRule.EffectiveEndDate" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="NewRule.Priority"></label>
                    <input asp-for="NewRule.Priority" type="number" class="form-control" />
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="NewRule.DisplayOrder"></label>
                    <input asp-for="NewRule.DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="form-group col-md-1 d-flex align-items-end">
                    <div class="custom-control custom-switch mb-2">
                        <input asp-for="NewRule.IsPromotional" class="custom-control-input" id="NewRule_IsPromotional" />
                        <label class="custom-control-label" for="NewRule_IsPromotional">Promo</label>
                    </div>
                </div>
                <div class="form-group col-md-1 d-flex align-items-end">
                    <div class="custom-control custom-switch mb-2">
                        <input asp-for="NewRule.IsEnabled" class="custom-control-input" id="NewRule_IsEnabled" />
                        <label class="custom-control-label" for="NewRule_IsEnabled">On</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus mr-1"></i>Add Rule</button>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-list mr-2"></i>Field Pricing Rules</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Field</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Effective Dates</th>
                        <th>Time</th>
                        <th class="text-right">Rate</th>
                        <th class="text-center">Priority</th>
                        <th class="text-center">Order</th>
                        <th class="text-center">Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rules.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-muted text-center py-4">No pricing rules have been saved yet.</td>
                        </tr>
                    }
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td class="align-middle">@rule.Court?.CourtName</td>
                            <td class="align-middle">@rule.Name</td>
                            <td class="align-middle">
                                @if (rule.IsPromotional)
                                {
                                    <span class="badge badge-success">Promo</span>
                                }
                                else
                                {
                                    <span class="badge badge-light border">Normal</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (rule.IsPromotional)
                                {
                                    <span>@rule.EffectiveStartDate?.ToString("MMM d, yyyy") - @rule.EffectiveEndDate?.ToString("MMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Always</span>
                                }
                            </td>
                            <td class="align-middle">@PhilippineTime.FormatTime(rule.StartTime) - @PhilippineTime.FormatTime(rule.EndTime)</td>
                            <td class="align-middle text-right">@rule.HourlyRate.ToString("0.00")</td>
                            <td class="align-middle text-center">@rule.Priority</td>
                            <td class="align-middle text-center">@rule.DisplayOrder</td>
                            <td class="align-middle text-center">
                                @if (rule.IsEnabled)
                                {
                                    <span class="badge badge-primary">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Disabled</span>
                                }
                            </td>
                            <td class="align-middle text-right">
                                <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-pen mr-1"></i>Edit
                                </a>
                                <form asp-action="Toggle" asp-route-id="@rule.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(rule.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@rule.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this pricing rule?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
