@model CourtBookingSystem.Areas.Admin.ViewModels.BookingPricingRuleFormViewModel
@{
    ViewData["Title"] = "Edit Pricing Rule";
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-pen mr-2"></i>Edit Pricing Rule</h5>
    </div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="CourtId"></label>
                    <select asp-for="CourtId" class="form-control">
                        @foreach (var court in Model.Courts)
                        {
                            <option value="@court.Id">@court.CourtName</option>
                        }
                    </select>
                    <span asp-validation-for="CourtId" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="StartTime"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="EndTime"></label>
                    <input asp-for="EndTime" type="time" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-2">
                    <label asp-for="HourlyRate"></label>
                    <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="HourlyRate" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="EffectiveStartDate"></label>
                    <input asp-for="EffectiveStartDate" type="date" class="form-control" />
                    <span asp-validation-for="EffectiveStartDate" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="EffectiveEndDate"></label>
                    <input asp-for="EffectiveEndDate" type="date" class="form-control" />
                    <span asp-validation-for="EffectiveEndDate" class="text-danger small"></span>
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="Priority"></label>
                    <input asp-for="Priority" type="number" class="form-control" />
                </div>
                <div class="form-group col-md-2">
                    <label asp-for="DisplayOrder"></label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-2">
                    <div class="custom-control custom-switch">
                        <input asp-for="IsPromotional" class="custom-control-input" id="IsPromotional" />
                        <label class="custom-control-label" for="IsPromotional">Promo</label>
                    </div>
                </div>
                <div class="form-group col-md-2">
                    <div class="custom-control custom-switch">
                        <input asp-for="IsEnabled" class="custom-control-input" id="IsEnabled" />
                        <label class="custom-control-label" for="IsEnabled">Enabled</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <a asp-action="Index" class="btn btn-link">Cancel</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Save Rule</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
