@model CourtBookingSystem.Areas.Admin.ViewModels.BlockedSlotFormViewModel
@{
    ViewData["Title"] = "Blocked Slots";
    string formatTime(TimeSpan t) => PhilippineTime.FormatTime(t);
}

<div class="row">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-plus mr-2"></i>Block a Slot</h5></div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="form-group">
                        <label asp-for="CourtId"></label>
                        <select asp-for="CourtId" class="form-control">
                            @foreach (var c in Model.Courts) { <option value="@c.Id">@c.CourtName — @c.SportType</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="BlockedDate"></label>
                        <input asp-for="BlockedDate" type="date" class="form-control" />
                        <span asp-validation-for="BlockedDate" class="text-danger small"></span>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label asp-for="StartTime"></label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="form-group col-6">
                            <label asp-for="EndTime"></label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Reason"></label>
                        <input asp-for="Reason" class="form-control" placeholder="Maintenance, private event, ..." />
                    </div>
                </div>
                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-ban mr-1"></i>Block Slot</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0"><i class="fas fa-list mr-2"></i>Existing Blocks (@Model.Existing.Count)</h5></div>
            <div class="card-body p-0">
                @if (!Model.Existing.Any())
                {
                    <div class="p-4 text-muted text-center">No blocked slots.</div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr><th>Field</th><th>Date</th><th>Time</th><th>Reason</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var s in Model.Existing)
                        {
                            <tr>
                                <td>@s.Court?.CourtName</td>
                                <td>@s.BlockedDate.ToString("MMM d, yyyy")</td>
                                <td>@formatTime(s.StartTime) – @formatTime(s.EndTime)</td>
                                <td>@(s.Reason ?? "—")</td>
                                <td class="text-right">
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this blocked slot?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
