@{
    ViewData["Title"] = "Find Available Turf Time";
    var sport = (SportType)ViewBag.Sport;
    var date = (string)ViewBag.Date;
    var duration = (int)ViewBag.Duration;
    var minDate = (string)ViewBag.MinDate;
    var maxDate = (string)ViewBag.MaxDate;
}

<section class="section-default">
    <div class="container">
        <div class="row mb-3">
            <div class="col">
                <h2 class="mb-1"><i class="fas fa-search-location mr-2 text-primary"></i>Find Available Turf Time</h2>
                <p class="text-muted">Pick a date and duration. We'll show open slots across our turf fields.</p>
            </div>
        </div>

        <div class="card booking-card mb-3">
            <div class="card-body">
                <form id="availabilityForm" class="form-row align-items-end">
                    <input type="hidden" name="sport" id="sport" value="@sport" />
                    <div class="form-group col-md-4">
                        <label for="date" class="quick-label">Date</label>
                        <input type="date" name="date" id="date" class="form-control" value="@date" min="@minDate" max="@maxDate" />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="durationHours" class="quick-label">Duration</label>
                        <select name="durationHours" id="durationHours" class="form-control">
                            @for (var hours = 1; hours <= 8; hours++)
                            {
                                <option value="@hours" selected="@(duration == hours)">@(hours == 1 ? "1 hour" : $"{hours} hours")</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <button type="submit" class="btn btn-primary btn-block btn-lg quick-search-btn">
                            <i class="fas fa-search mr-1"></i>Find Times
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div id="resultsHeader" class="mb-2 text-muted small" style="display:none;"></div>
        <div id="results"></div>
    </div>
</section>

@section Scripts {
    <script>
        (function ($) {
            "use strict";
            var $form = $("#availabilityForm");
            var $results = $("#results");
            var $header = $("#resultsHeader");

            function turfText(text) {
                return String(text || "")
                    .replace(/Giuseppe Football Club/gi, "CAMPO TURF")
                    .replace(/Giuseppe Football Field/gi, "CAMPO TURF Field")
                    .replace(/Football Field/gi, "Turf Field")
                    .replace(/football field/gi, "turf field");
            }

            function formatMoney(value) {
                return Number(value || 0).toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function load() {
                var sport = $("#sport").val();
                var date = $("#date").val();
                var dur = parseInt($("#durationHours").val(), 10) || 1;
                if (!sport || !date) return;

                $results.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin mr-1"></i>Searching…</div>');
                $header.hide();

                $.getJSON('@Url.Action("Search", "Availability")', { sport: sport, date: date, durationHours: dur })
                    .done(render)
                    .fail(function () {
                        $results.html('<div class="alert alert-danger">Failed to load availability. Please try again.</div>');
                    });
            }

            function render(payload) {
                if (!payload || !payload.slots || payload.slots.length === 0) {
                    $results.html('<div class="alert alert-warning"><i class="fas fa-circle-info mr-2"></i>No available turf slots for this date and duration. Try a different day or shorter duration.</div>');
                    $header.hide();
                    return;
                }
                $header.text(payload.count + " available slot" + (payload.count === 1 ? "" : "s") + " found").show();

                // Read duration from the dropdown (scoped inside render)
                var dur = parseInt($("#durationHours").val(), 10) || 1;
                // Group by court for cleaner display
                var byCourt = {};
                payload.slots.forEach(function (s) {
                    (byCourt[s.courtName] = byCourt[s.courtName] || []).push(s);
                });

                var html = '';
                Object.keys(byCourt).forEach(function (court) {
                    var slots = byCourt[court];
                    html += '<div class="card availability-card mb-3">';
                    html += '<div class="card-header d-flex justify-content-between align-items-center">';
                    html += '<h6 class="mb-0"><i class="fas fa-layer-group mr-2 text-primary"></i>' + turfText(court) + '</h6>';
                    html += '<span class="text-muted small">' + slots.length + ' open · Turf Field</span>';
                    html += '</div>';
                    html += '<div class="card-body p-2"><div class="availability-slots">';
                    slots.forEach(function (s) {
                        var url = '@Url.Action("Create", "Bookings")?courtId=' + s.courtId
                                + '&date=' + s.date
                                + '&time=' + encodeURIComponent(s.startTime)
                                + '&durationHours=' + dur;
                        var rateClass = s.isMixedRate ? ' slot-mixed' : (s.isPromoRate ? ' slot-promo' : '');
                        html += '<a href="' + url + '" class="availability-slot-btn' + rateClass + '">';
                        html += '<span class="time">' + s.startLabel + ' – ' + s.endLabel + '</span>';
                        var priceNote = s.isMixedRate ? ' mixed' : (s.isPromoRate ? ' promo' : '');
                        html += '<span class="price">' + formatMoney(s.totalAmount) + priceNote + '</span>';
                        html += '</a>';
                    });
                    html += '</div></div></div>';
                });
                $results.html(html);
            }

            $form.on("submit", function (e) { e.preventDefault(); load(); });
            $("#date, #durationHours").on("change", load);
            load(); // initial
        })(jQuery);
    </script>
}
