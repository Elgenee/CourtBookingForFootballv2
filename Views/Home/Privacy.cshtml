@{
    ViewData["Title"] = "Privacy Policy";
}
<section class="section-default">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Last updated: @PhilippineTime.Now.ToString("MMMM d, yyyy")</p>

        <h4 class="mt-4">Information we collect</h4>
        <p>
            We collect the booking information you submit (name, email, mobile number)
            for the purpose of processing your field reservations and contacting you
            about your booking.
        </p>

        <h4 class="mt-4">How we use information</h4>
        <ul>
            <li>To process and confirm field bookings.</li>
            <li>To verify payment proofs submitted by customers.</li>
            <li>To send booking-related updates or cancellation notices.</li>
        </ul>

        <h4 class="mt-4">Contact</h4>
        <p>For any privacy concerns, please reach out to the facility administration.</p>
    </div>
</section>
