@model IEnumerable<CourtBookingSystem.Models.Court>
@{
    ViewData["Title"] = "Home";
    var hero = ViewBag.Hero as CourtBookingSystem.Models.Cms.HeroImage;
    var about = ViewBag.About as CourtBookingSystem.Models.Cms.AboutContent
        ?? new CourtBookingSystem.Models.Cms.AboutContent();
    var galleryItems = ViewBag.Gallery as List<CourtBookingSystem.Models.Cms.GalleryImage>
        ?? new List<CourtBookingSystem.Models.Cms.GalleryImage>();

    var activeCourts = (Model ?? Enumerable.Empty<CourtBookingSystem.Models.Court>())
        .Where(c => c.IsActive)
        .ToList();
    string ImageUrl(string path) => path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/")
        ? path
        : "/" + path;
}

<!-- ============ HERO ============ -->
<section class="hero-section hero-image home-hero campo-home-hero" data-testid="hero-section"
         style="@(hero != null ? $"background-image: url('{(hero.ImagePath.StartsWith("http") ? hero.ImagePath : "/" + hero.ImagePath)}');" : "")">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="row">
            <div class="col-lg-7 col-xl-6">
                <div class="hero-eyebrow campo-hero-eyebrow">CAMPO TURF</div>
                <h1 class="hero-title mb-3" data-testid="hero-title">Play Your Game.</h1>
                <p class="hero-subtitle mb-4" data-testid="hero-subtitle">Your neighborhood turf.</p>
                <a asp-controller="Availability" asp-action="Find" class="btn btn-primary btn-lg hero-book-btn">
                    Book a Turf <i class="fas fa-arrow-right ml-2"></i>
                </a>
                <div class="campo-hero-notes" aria-label="Venue highlights">
                    <span>Hourly reservations</span>
                    <span>Team-ready turf</span>
                    <span>Easy online booking</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ RATES ============ -->
<section id="rates" class="section-default campo-rates-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <div class="section-header text-center mb-4">
                    <span class="section-eyebrow">Rates</span>
                    <h2>Hourly Rates</h2>
                    <p class="text-muted mb-0">Straightforward pricing for your next game.</p>
                </div>

                <div class="campo-rate-card campo-rate-simple">
                    @if (activeCourts.Any())
                    {
                        @foreach (var court in activeCourts)
                        {
                            <div class="campo-rate-row">
                                <div>
                                    <span class="court-sport-tag">@court.SportType</span>
                                    <h3>@court.CourtName</h3>
                                    @if (!string.IsNullOrWhiteSpace(court.Description))
                                    {
                                        <p>@court.Description</p>
                                    }
                                </div>
                                <div class="campo-rate-price">
                                    @court.HourlyRate.ToString("0.00") <span>/ hour</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">Rates will appear here when turf information is available.</p>
                    }
                    <a asp-controller="Availability" asp-action="Find" class="btn btn-primary btn-block mt-4">Book a Turf</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ GALLERY ============ -->
<section id="facilities" class="section-default campo-gallery-section" data-testid="section-gallery">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Take a look</span>
            <h2>Gallery</h2>
            <p class="text-muted">A peek inside the courts, the lounge, and the action.</p>
        </div>

        <div class="row">
            @foreach (var item in galleryItems)
            {
                <div class="col-12 col-sm-6 col-lg-3 mb-4">
                    <div class="gallery-card" data-testid="gallery-card-@item.Id">
                        <div class="gallery-image-wrap">
                            <img src="@ImageUrl(item.ImagePath)" alt="@item.Title" loading="lazy" />
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                        <div class="gallery-body">
                            <h6 class="gallery-title">@item.Title</h6>
                            @if (!string.IsNullOrWhiteSpace(item.Caption))
                            {
                                <p class="gallery-caption">@item.Caption</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="section-light campo-contact-section" data-testid="section-about">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Contact</span>
            <h2>Visit CAMPO TURF</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="far fa-clock"></i></div>
                    <div>
                        <h3>Opening Hours</h3>
                        <p class="mb-0">
                            @(about.OpeningHoursDays ?? "Mon - Sun")<br />
                            <strong data-testid="about-hours">@(about.OpeningHoursTimes ?? "8:00 AM - 10:00 PM")</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="fas fa-phone"></i></div>
                    <div>
                        <h3>Contact Number</h3>
                        <p class="mb-0">
                            <strong data-testid="about-phone">@(about.ContactPhone ?? "")</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="fas fa-location-dot"></i></div>
                    <div>
                        <h3>Location</h3>
                        <p class="mb-0">
                            <strong data-testid="about-location">@(about.Location ?? "")</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
