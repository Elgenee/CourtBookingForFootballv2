@model IEnumerable<CourtBookingSystem.Models.Court>
@{
    ViewData["Title"] = "Home";
    var hero = ViewBag.Hero as CourtBookingSystem.Models.Cms.HeroImage;
    var about = ViewBag.About as CourtBookingSystem.Models.Cms.AboutContent
        ?? new CourtBookingSystem.Models.Cms.AboutContent();
    var galleryItems = ViewBag.Gallery as List<CourtBookingSystem.Models.Cms.GalleryImage>
        ?? new List<CourtBookingSystem.Models.Cms.GalleryImage>();
    var contactEmail = about.ContactEmail?.Trim();
    var schedulingPhone = about.ContactPhone;
    var contactPhoneLink = "tel:" + new string((schedulingPhone ?? "")
        .Where(c => char.IsDigit(c) || c == '+').ToArray());
    var eventsPhoneLink = "tel:" + new string((about.EventsPhone ?? "").Where(c => char.IsDigit(c) || c == '+').ToArray());

    var activeCourts = (Model ?? Enumerable.Empty<CourtBookingSystem.Models.Court>())
        .Where(c => c.IsActive)
        .ToList();
    var pricingRulesByCourt = ViewBag.PricingRulesByCourt as IDictionary<int, List<BookingPricingRule>>
        ?? new Dictionary<int, List<BookingPricingRule>>();
    string ImageUrl(string path) => path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/")
        ? path
        : "/" + path;
    string TurfText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        return text
            .Replace("Giuseppe Football Club", "CAMPO TURF", StringComparison.OrdinalIgnoreCase)
            .Replace("Giuseppe Football Field", "CAMPO TURF Field", StringComparison.OrdinalIgnoreCase)
            .Replace("Football Field", "Turf Field", StringComparison.OrdinalIgnoreCase)
            .Replace("football field", "turf field", StringComparison.OrdinalIgnoreCase)
            .Replace("(Football + Caf\u00e9)", "", StringComparison.OrdinalIgnoreCase);
    }
    string RuleWindow(BookingPricingRule rule) =>
        $"{PhilippineTime.FormatTime(rule.StartTime)} - {PhilippineTime.FormatTime(rule.EndTime)}";
    // Presentation labels only; the configured time windows and amounts remain authoritative.
    (string Key, string Label, string Icon) RatePeriod(TimeSpan start) => start.Hours switch
    {
        >= 5 and < 12 => ("morning", "Morning", "fas fa-cloud-sun"),
        >= 12 and < 18 => ("afternoon", "Afternoon", "fas fa-sun"),
        _ => ("night", "Night", "fas fa-moon")
    };
    string RateAmount(decimal rate) => rate.ToString(rate == decimal.Truncate(rate) ? "N0" : "N2");
    string RuleDates(BookingPricingRule rule)
    {
        if (!rule.IsPromotional) return "All dates";
        if (rule.EffectiveStartDate.HasValue && rule.EffectiveEndDate.HasValue)
        {
            return rule.EffectiveStartDate.Value.Date == rule.EffectiveEndDate.Value.Date
                ? rule.EffectiveStartDate.Value.ToString("MMM d, yyyy")
                : $"{rule.EffectiveStartDate.Value:MMM d, yyyy} - {rule.EffectiveEndDate.Value:MMM d, yyyy}";
        }
        if (rule.EffectiveStartDate.HasValue) return $"From {rule.EffectiveStartDate.Value:MMM d, yyyy}";
        if (rule.EffectiveEndDate.HasValue) return $"Until {rule.EffectiveEndDate.Value:MMM d, yyyy}";
        return "Promo dates";
    }
    string GalleryIcon(string? title)
    {
        var text = (title ?? "").ToLowerInvariant();
        if (text.Contains("eat") || text.Contains("food") || text.Contains("cafe") || text.Contains("lounge"))
        {
            return "fas fa-utensils";
        }
        if (text.Contains("training") || text.Contains("session"))
        {
            return "fas fa-dumbbell";
        }
        if (text.Contains("match") || text.Contains("game"))
        {
            return "fas fa-futbol";
        }
        return "fas fa-border-all";
    }
}

<!-- ============ HERO ============ -->
<section class="hero-section hero-image home-hero campo-home-hero" data-testid="hero-section"
         style="@(hero != null ? $"background-image: url('{(hero.ImagePath.StartsWith("http") ? hero.ImagePath : "/" + hero.ImagePath)}');" : "")">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="row">
            <div class="col-lg-7 col-xl-6">
                <div class="hero-eyebrow campo-hero-eyebrow">CAMPO TURF</div>
                <h1 class="hero-title mb-3" data-testid="hero-title">Play Your <span>Game.</span></h1>
                <p class="hero-subtitle mb-4" data-testid="hero-subtitle">A multi-purpose sports turf for teams, schools, and community play.</p>
                <a asp-controller="Availability" asp-action="Find" class="btn btn-primary btn-lg hero-book-btn">
                    Book a Turf <i class="fas fa-arrow-right ml-2"></i>
                </a>
        @*         <div class="campo-hero-notes" aria-label="Venue highlights">
                    <span>Hourly reservations</span>
                    <span>Multi-purpose turf field</span>
                    <span>Easy online booking</span>
                </div> *@
            </div>
        </div>
    </div>
</section>

<div class="campo-home-main-sections">
<!-- ============ RATES ============ -->
<section id="rates" class="section-default campo-rates-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-10">
                <div class="section-header text-center mb-4">
                    <span class="section-eyebrow">Rates</span>
                    <h2>Hourly <span>Rates</span></h2>
                    <p class="mb-0">Simple hourly pricing for matches, training, school activities, and private bookings.</p>
                </div>

                <div class="campo-rate-card campo-rate-simple">
                    @if (activeCourts.Any())
                    {
                        @foreach (var court in activeCourts)
                        {
                            var pricingRules = pricingRulesByCourt.TryGetValue(court.Id, out var configuredRules)
                                ? configuredRules
                                : new List<BookingPricingRule>();
                            <div class="campo-rate-row">
                                <div class="campo-rate-copy">
                                    <span class="court-sport-tag">Turf Field</span>
                                    <h3>@TurfText(court.CourtName)</h3>
                                    @if (!string.IsNullOrWhiteSpace(court.Description))
                                    {
                                        <p>@TurfText(court.Description)</p>
                                    }
                                </div>
                                <div class="campo-rate-rules" aria-label="Pricing rules for @TurfText(court.CourtName)">
                                    @if (pricingRules.Any())
                                    {
                                        @foreach (var rule in pricingRules)
                                        {
                                            var period = RatePeriod(rule.StartTime);
                                            <div class="campo-rate-rule campo-rate-rule--@period.Key">
                                                <span class="campo-rate-icon" aria-hidden="true"><i class="@period.Icon"></i></span>
                                                <div class="campo-rate-rule-main">
                                                    <div class="campo-rate-rule-heading">
                                                        <span class="campo-rate-period">@period.Label</span>
                                                        <span class="campo-rate-rule-type @(rule.IsPromotional ? "is-promo" : "")">
                                                            @(rule.IsPromotional ? "Promo" : "Regular")
                                                        </span>
                                                    </div>
                                                    <strong>@RuleWindow(rule)</strong>
                                                    <span class="campo-rate-rule-meta">@rule.Name · @RuleDates(rule)</span>
                                                </div>
                                                <div class="campo-rate-rule-price">
                                                    <div><span>₱</span> @RateAmount(rule.HourlyRate)</div>
                                                    <small>/ hour</small>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="campo-rate-rule">
                                            <span class="campo-rate-icon" aria-hidden="true"><i class="far fa-clock"></i></span>
                                            <div class="campo-rate-rule-main">
                                                <div class="campo-rate-rule-heading">
                                                    <span class="campo-rate-period">Standard rate</span>
                                                    <span class="campo-rate-rule-type">Base</span>
                                                </div>
                                                <strong>All operating hours</strong>
                                                <span class="campo-rate-rule-meta">Fallback court rate</span>
                                            </div>
                                            <div class="campo-rate-rule-price">
                                                <div><span>₱</span> @RateAmount(court.HourlyRate)</div>
                                                <small>/ hour</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">Rates will appear here when turf information is available.</p>
                    }
                    <a asp-controller="Availability" asp-action="Find" class="btn btn-primary btn-block mt-4">Book a Turf <i class="fas fa-chevron-right ml-2" aria-hidden="true"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ ACTIVITIES ============ -->
<section id="activities" class="section-default campo-activities-section campo-sports-section" data-testid="section-activities" aria-labelledby="sports-title">
    <div class="container">
        <div class="section-header">
            <span class="section-eyebrow">Bring any ball</span>
            <h2 id="sports-title">Five sports, <em>one pitch.</em></h2>
            <p class="mb-0">Same price for every sport. Tap one to start booking it.</p>
        </div>

        <div class="campo-activities-grid" aria-label="Supported activities">
            <a asp-controller="Availability" asp-action="Find" class="campo-activity-item campo-sport-card">
                <span class="campo-sport-art"><img src="~/img/sports/football-realistic.webp" asp-append-version="true" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
                <strong>Football</strong>
                <small>5s &amp; 7s</small>
                <span class="campo-sport-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
            </a>
            <a asp-controller="Availability" asp-action="Find" class="campo-activity-item campo-sport-card">
                <span class="campo-sport-art"><img src="~/img/sports/flag-football-realistic.webp" asp-append-version="true" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
                <strong>Flag football</strong>
                <small>belts and leagues</small>
                <span class="campo-sport-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
            </a>
            <a asp-controller="Availability" asp-action="Find" class="campo-activity-item campo-sport-card">
                <span class="campo-sport-art"><img src="~/img/sports/frisbee-realistic.webp" asp-append-version="true" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
                <strong>Frisbee</strong>
                <small>ultimate, open play</small>
                <span class="campo-sport-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
            </a>
            <a asp-controller="Availability" asp-action="Find" class="campo-activity-item campo-sport-card">
                <span class="campo-sport-art"><img src="~/img/sports/rugby-realistic.webp" asp-append-version="true" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
                <strong>Rugby</strong>
                <small>touch &amp; tag</small>
                <span class="campo-sport-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
            </a>
            <a asp-controller="Availability" asp-action="Find" class="campo-activity-item campo-sport-card">
                <span class="campo-sport-art"><img src="~/img/sports/cricket-realistic.webp" asp-append-version="true" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
                <strong>Cricket</strong>
                <small>box cricket</small>
                <span class="campo-sport-arrow" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
            </a>
        </div>
    </div>
</section>

<div class="campo-gallery-contact-wrap">
<!-- ============ GALLERY ============ -->
<section id="facilities" class="section-default campo-gallery-section" data-testid="section-gallery">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Take a look</span>
            <h2>Gallery</h2>
            <p class="text-muted">A peek inside the turf field, the lounge, and the action.</p>
        </div>

        <div class="row">
            @foreach (var item in galleryItems)
            {
                <div class="col-12 col-md-6 mb-3">
                    <div class="gallery-card" data-testid="gallery-card-@item.Id">
                        <div class="gallery-image-wrap">
                            <img src="@ImageUrl(item.ImagePath)" alt="@TurfText(item.Title)" loading="lazy" />
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                        <div class="gallery-body">
                            <span class="gallery-card-icon" aria-hidden="true"><i class="@GalleryIcon(item.Title)"></i></span>
                            <div class="gallery-copy">
                                <h6 class="gallery-title">@TurfText(item.Title)</h6>
                                @if (!string.IsNullOrWhiteSpace(item.Caption))
                                {
                                    <p class="gallery-caption">@TurfText(item.Caption)</p>
                                }
                            </div>
                            <a href="@ImageUrl(item.ImagePath)" class="gallery-photo-link" target="_blank" rel="noopener noreferrer" aria-label="View photo: @TurfText(item.Title)">
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="section-light campo-contact-section" data-testid="section-about">
    <div class="container">
        <div class="section-header text-center campo-contact-heading">
            <span class="section-eyebrow">Get in touch</span>
            <h2>Contact <span>Us</span></h2>
            <p>Have questions or need assistance? We're here to help.<br class="d-none d-md-inline" />
                Reach out to us through any of the channels below.</p>
        </div>

        <div class="row campo-contact-layout">
            <div class="col-lg-5 mb-4 mb-lg-0">
                <div class="campo-contact-details">
                    <div class="campo-contact-item">
                        <div class="campo-contact-icon" aria-hidden="true"><i class="fas fa-location-dot"></i></div>
                        <div>
                            <h3>Location</h3>
                            <p class="mb-0"><strong data-testid="about-location">@about.Location</strong></p>
                        </div>
                    </div>

                    <div class="campo-contact-item">
                        <div class="campo-contact-icon" aria-hidden="true"><i class="fas fa-phone"></i></div>
                        <div>
                            <h3>Phone</h3>
                            @if (!string.IsNullOrWhiteSpace(schedulingPhone))
                            {
                                <p class="mb-0">
                                    <small>For scheduling:</small>
                                    <a href="@contactPhoneLink" data-testid="about-phone">@schedulingPhone</a>
                                    @if (!string.IsNullOrWhiteSpace(about.SchedulingContactName))
                                    {
                                        <span>· @about.SchedulingContactName</span>
                                    }
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(about.EventsPhone))
                            {
                                <p class="mb-0 mt-2">
                                    <small>For events / inquiries:</small>
                                    <a href="@eventsPhoneLink" data-testid="about-events-phone">@about.EventsPhone</a>
                                    @if (!string.IsNullOrWhiteSpace(about.EventsContactName))
                                    {
                                        <span>· @about.EventsContactName</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(contactEmail))
                    {
                        <div class="campo-contact-item">
                            <div class="campo-contact-icon" aria-hidden="true"><i class="fas fa-envelope"></i></div>
                            <div>
                                <h3>Email</h3>
                                <p class="mb-0"><a href="mailto:@contactEmail">@contactEmail</a></p>
                                <small>We'd love to hear from you.</small>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(about.FacebookUrl) || !string.IsNullOrWhiteSpace(about.InstagramUrl))
                    {
                        <div class="campo-contact-item">
                            <div class="campo-contact-icon" aria-hidden="true"><i class="fas fa-share-nodes"></i></div>
                            <div>
                                <h3>Social Media</h3>
                                <div class="campo-contact-social-links">
                                    @if (!string.IsNullOrWhiteSpace(about.FacebookUrl))
                                    {
                                        <a href="@about.FacebookUrl" target="_blank" rel="noopener noreferrer">
                                            <i class="fab fa-facebook-f" aria-hidden="true"></i>
                                            <span>Facebook · @about.FacebookName</span>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(about.InstagramUrl))
                                    {
                                        <a href="@about.InstagramUrl" target="_blank" rel="noopener noreferrer">
                                            <i class="fab fa-instagram" aria-hidden="true"></i>
                                            <span>Instagram · @about.InstagramHandle</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-7">
                <div class="campo-contact-panel">
                    <div>
                        <span class="campo-message-icon" aria-hidden="true"><i class="far fa-comments"></i></span>
                        <h3>Send us a Message</h3>
                        <p class="mb-0">Chat with our team about bookings, events, or your next visit.</p>
                    </div>
                    <div class="campo-contact-actions">
                        @if (!string.IsNullOrWhiteSpace(about.FacebookUrl))
                        {
                            <a class="btn campo-contact-message-btn" href="@about.FacebookUrl" target="_blank" rel="noopener noreferrer">
                                <i class="fab fa-facebook-messenger" aria-hidden="true"></i>
                                <span>Message us on Facebook<small>@about.FacebookName</small></span>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(about.InstagramUrl))
                        {
                            <a class="btn campo-contact-instagram-btn" href="@about.InstagramUrl" target="_blank" rel="noopener noreferrer">
                                <i class="fab fa-instagram" aria-hidden="true"></i>
                                <span>Message us on Instagram<small>@about.InstagramHandle</small></span>
                            </a>
                        }
                    </div>
                    <div class="campo-contact-hours">
                        <i class="far fa-clock" aria-hidden="true"></i>
                        <div>
                            <h4>Opening Hours</h4>
                            <p class="mb-0">
                                @(about.OpeningHoursDays ?? "Mon - Sun")<br />
                                <strong data-testid="about-hours">@(about.OpeningHoursTimes ?? "6:00 AM – 4:00 AM (next day)")</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
</div>
