@model IEnumerable<CourtBookingSystem.Models.Court>
@{
    ViewData["Title"] = "Home";
    var settings = ViewBag.Settings as CourtBookingSystem.Models.Cms.WebsiteSetting
        ?? new CourtBookingSystem.Models.Cms.WebsiteSetting();
    var hero = ViewBag.Hero as CourtBookingSystem.Models.Cms.HeroImage;
    var about = ViewBag.About as CourtBookingSystem.Models.Cms.AboutContent
        ?? new CourtBookingSystem.Models.Cms.AboutContent();
    var galleryItems = ViewBag.Gallery as List<CourtBookingSystem.Models.Cms.GalleryImage>
        ?? new List<CourtBookingSystem.Models.Cms.GalleryImage>();
    var promoCards = ViewBag.Promotions as List<CourtBookingSystem.Models.Cms.Promotion>
        ?? new List<CourtBookingSystem.Models.Cms.Promotion>();

    var facilityLines = (about.FacilitiesList ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .Where(s => s.Length > 0)
        .ToList();

    string ImageUrl(string path) => path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/")
        ? path
        : "/" + path;
    string ImageAlt(CourtBookingSystem.Models.Cms.Promotion card) => string.IsNullOrWhiteSpace(card.ImageAlt)
        ? $"{card.Title} promotion image"
        : card.ImageAlt;
    var minDate = PhilippineTime.Today.ToString("yyyy-MM-dd");
    var maxDate = PhilippineTime.Today.AddYears(5).ToString("yyyy-MM-dd");
    var announcement = promoCards.FirstOrDefault();
    var showAnnouncementAction = announcement != null
        && !string.IsNullOrWhiteSpace(announcement.ButtonLabel)
        && !string.IsNullOrWhiteSpace(announcement.ButtonUrl);
}

@if (announcement != null)
{
    @section AnnouncementBar {
        <div class="announcement-bar alert alert-warning alert-dismissible fade show mb-0 rounded-0 border-0" role="alert">
            <div class="container">
                <div class="announcement-inner">
                    <div class="announcement-message">
                        <span class="announcement-icon" aria-hidden="true">@Html.Raw(announcement.IconHtml)</span>
                        <span><strong>@announcement.Title:</strong> @announcement.ImageAlt</span>
                    </div>
                    @if (showAnnouncementAction)
                    {
                        <a href="@announcement.ButtonUrl" class="btn btn-sm btn-primary announcement-action">@announcement.ButtonLabel</a>
                    }
                    <button type="button" class="close announcement-close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }
}

<!-- ============ HERO ============ -->
<section class="hero-section hero-image home-hero" data-testid="hero-section"
         style="@(hero != null ? $"background-image: url('{(hero.ImagePath.StartsWith("http") ? hero.ImagePath : "/" + hero.ImagePath)}');" : "")">
    <div class="hero-overlay"></div>
</section>

<!-- ============ HERO INTRO / QUICK BOOKING ============ -->
<section class="section-light home-hero-content">
    <div class="container">
        <div id="booking-search" class="quick-widget-section">
            <div class="quick-widget">
                <h5 class="quick-widget-title">
                    <i class="fas fa-search-location mr-2"></i>Find Available Fields &amp; Times
                </h5>
                <form asp-controller="Availability" asp-action="Find" method="get" class="quick-widget-form">
                    <div class="form-row align-items-end">
                        <div class="form-group col-md-3">
                            <label for="sport" class="quick-label">Sport</label>
                            <select name="sport" id="sport" class="form-control">
                                @foreach (var s in Enum.GetValues<SportType>())
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <label for="date" class="quick-label">Date</label>
                            <input type="date" name="date" id="date" class="form-control"
                                   value="@minDate" min="@minDate" max="@maxDate" />
                        </div>
                        <div class="form-group col-md-3">
                            <label for="durationHours" class="quick-label">Duration</label>
                            <select name="durationHours" id="durationHours" class="form-control">
                                @for (var hours = 1; hours <= 8; hours++)
                                {
                                    <option value="@hours">@(hours == 1 ? "1 hour" : $"{hours} hours")</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-3">
                            <button type="submit" class="btn btn-primary btn-block btn-lg quick-search-btn">
                                <i class="fas fa-search mr-1"></i>Find Available Field Times
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row justify-content-center text-center home-intro-copy">
            <div class="col-xl-9 col-lg-10">
                <div class="home-intro-panel">
                    <div class="home-brand-mark">
                        @if (!string.IsNullOrEmpty(settings.NavbarLogoPath))
                        {
                            <img src="@(settings.NavbarLogoPath.StartsWith("http") ? settings.NavbarLogoPath : "/" + settings.NavbarLogoPath)"
                                 alt="@settings.WebsiteName logo"
                                 class="home-brand-logo" />
                        }
                        else
                        {
                            <span class="home-brand-logo-fallback">
                                <i class="fas fa-calendar-check"></i>
                            </span>
                        }
                    </div>
                    <div class="home-intro-tagline text-primary" data-testid="hero-eyebrow">
                        <span class="home-intro-tagline-text">Your Game Starts Here</span>
                        <span class="home-intro-open">Open Daily</span>
                    </div>
                    <h1 class="hero-title text-dark mb-3" data-testid="hero-title">
                        Giuseppe Football
                    </h1>
                    <p class="hero-subtitle text-muted mx-auto mb-4" data-testid="hero-subtitle">
                        Book your preferred field and playing time online in just a few steps.
                    </p>
                    <div class="home-intro-highlights" aria-label="Booking highlights">
                        <div class="home-intro-highlight">
                            <span class="home-highlight-icon">
                                <i class="fas fa-bolt"></i>
                            </span>
                            <span>Quick Online Booking</span>
                        </div>
                        <div class="home-intro-highlight">
                            <span class="home-highlight-icon">
                                <i class="fas fa-trophy"></i>
                            </span>
                            <span>Budget-Friendly Prices</span>
                        </div>
                        <div class="home-intro-highlight">
                            <span class="home-highlight-icon">
                                <i class="fas fa-parking"></i>
                            </span>
                            <span>Convenient Parking</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ PROMOTIONS AND EVENTS ============ -->
<section id="promos" class="section-default promos-section">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Promotions &amp; Events</span>
            <h2>What's Happening at Giuseppe Football</h2>
            <p class="text-muted">Stay updated with our latest promotions, tournaments, and facility announcements.</p>
        </div>

        @if (promoCards.Any())
        {
            <div class="row justify-content-center">
                @foreach (var card in promoCards)
                {
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card promo-card h-100">
                            <div class="promo-image-wrap">
                                <img src="@ImageUrl(card.ImagePath)" alt="@ImageAlt(card)" class="promo-image" loading="lazy" />
                                <span class="promo-type">@card.AnnouncementType</span>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="promo-card-heading">
                                    <span class="promo-card-icon" aria-hidden="true">@Html.Raw(card.IconHtml)</span>
                                    <h5 class="card-title mb-0">@card.Title</h5>
                                </div>
                                <p class="card-text text-muted">@card.Description</p>
                                <a href="@card.ButtonUrl" class="btn btn-outline-primary mt-auto align-self-start">
                                    @card.ButtonLabel <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ============ ABOUT GIUSEPPE FOOTBALL ============ -->
<section id="about" class="section-light" data-testid="section-about">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">About Us</span>
            <h2 data-testid="about-title">@about.Title</h2>
            <p class="lead mx-auto" style="max-width: 760px;" data-testid="about-description">
                @about.Description
            </p>
        </div>

        <div class="row justify-content-center">
            <!-- Facilities -->
            <div class="col-lg-8 mb-4">
                <div class="card about-card h-100">
                    <div class="card-body">
                        <div class="about-card-header">
                            <div class="about-icon about-icon-accent"><i class="fas fa-building"></i></div>
                            <h4 class="mb-0">Facilities</h4>
                        </div>
                        <ul class="about-list two-col" data-testid="about-facilities">
                            @foreach (var facility in facilityLines)
                            {
                                <li><i class="fas fa-check about-bullet text-success"></i>@facility</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info cards row -->
        <div class="row mt-2 justify-content-center">
            <div class="col-6 col-lg-3 mb-3">
                <div class="info-card h-100">
                    <div class="info-icon"><i class="fas fa-clock"></i></div>
                    <h6 class="info-title">Opening Hours</h6>
                    <p class="info-text mb-0">
                        @(about.OpeningHoursDays ?? "Mon – Sun")<br />
                        <strong data-testid="about-hours">@(about.OpeningHoursTimes ?? "8:00 AM – 10:00 PM")</strong>
                    </p>
                </div>
            </div>
            <div class="col-6 col-lg-3 mb-3">
                <div class="info-card h-100">
                    <div class="info-icon"><i class="fas fa-phone"></i></div>
                    <h6 class="info-title">Contact Number</h6>
                    <p class="info-text mb-0">
                        <strong data-testid="about-phone">@(about.ContactPhone ?? "")</strong><br />
                        <span class="small text-muted">Hotline</span>
                    </p>
                </div>
            </div>
           @*  <div class="col-6 col-lg-3 mb-3">
                <div class="info-card h-100">
                    <div class="info-icon"><i class="fas fa-envelope"></i></div>
                    <h6 class="info-title">Email Address</h6>
                    <p class="info-text mb-0">
                        <strong data-testid="about-email">@(about.ContactEmail ?? "")</strong><br />
                        <span class="small text-muted">We reply within 1 hr</span>
                    </p>
                </div>
            </div> *@

            <div class="col-6 col-lg-3 mb-3">
                <div class="info-card h-100">
                    <div class="info-icon"><i class="fab fa-facebook-f"></i></div>
                    <h6 class="info-title">Facebook Page</h6>
                    <p class="info-text mb-0">
                        <a href="https://www.facebook.com/CampoGFC/"
                           target="_blank"
                           rel="noopener noreferrer"
                           data-testid="about-facebook">
                            Giuseppe Football
                        </a><br />
                        <span class="small text-muted">Follow us for updates</span>
                    </p>
                </div>
            </div>
            <div class="col-6 col-lg-3 mb-3">
                <div class="info-card h-100">
                    <div class="info-icon"><i class="fas fa-location-dot"></i></div>
                    <h6 class="info-title">Location</h6>
                    <p class="info-text mb-0">
                        <strong data-testid="about-location">@(about.Location ?? "")</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ GALLERY ============ -->
<section id="gallery" class="section-default" data-testid="section-gallery">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Take a look</span>
            <h2>Gallery</h2>
            <p class="text-muted">A peek inside the fields, the lounge, and the action.</p>
        </div>

        <div class="row">
            @foreach (var item in galleryItems)
            {
                <div class="col-12 col-sm-6 col-lg-3 mb-4">
                    <div class="gallery-card" data-testid="gallery-card-@item.Id">
                        <div class="gallery-image-wrap">
                            <img src="@(item.ImagePath.StartsWith("http") ? item.ImagePath : "/" + item.ImagePath)"
                                 alt="@item.Title" loading="lazy" class="gallery-image" />
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                        <div class="gallery-body">
                            <h6 class="gallery-title">@item.Title</h6>
                            @if (!string.IsNullOrWhiteSpace(item.Caption))
                            {
                                <p class="gallery-caption">@item.Caption</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

