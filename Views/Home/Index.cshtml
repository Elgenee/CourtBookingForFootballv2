<div class="campo-gallery-contact-wrap">
<!-- ============ GALLERY ============ -->
<section id="facilities" class="section-default campo-gallery-section" data-testid="section-gallery">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Take a look</span>
            <h2>Gallery</h2>
            <p class="text-muted">A peek inside the turf field, the lounge, and the action.</p>
        </div>

        <div class="row">
            @foreach (var item in galleryItems)
            {
                <div class="col-12 col-md-6 mb-4">
                    <div class="gallery-card" data-testid="gallery-card-@item.Id">
                        <div class="gallery-image-wrap">
                            <img src="@ImageUrl(item.ImagePath)" alt="@TurfText(item.Title)" loading="lazy" />
                            <div class="gallery-overlay">
                                <i class="fas fa-search-plus"></i>
                            </div>
                        </div>
                        <div class="gallery-body">
                            <span class="gallery-card-icon" aria-hidden="true"><i class="@GalleryIcon(item.Title)"></i></span>
                            <div class="gallery-copy">
                                <h6 class="gallery-title">@TurfText(item.Title)</h6>
                                @if (!string.IsNullOrWhiteSpace(item.Caption))
                                {
                                    <p class="gallery-caption">@TurfText(item.Caption)</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="section-light campo-contact-section" data-testid="section-about">
    <div class="container">
        <div class="section-header text-center mb-4">
            <span class="section-eyebrow">Contact</span>
            <h2>Visit CAMPO TURF</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="far fa-clock"></i></div>
                    <div>
                        <h3>Opening Hours</h3>
                        <p class="mb-0">
                            @(about.OpeningHoursDays ?? "Mon - Sun")<br />
                            <strong data-testid="about-hours">@(about.OpeningHoursTimes ?? "8:00 AM - 10:00 PM")</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="fas fa-phone"></i></div>
                    <div>
                        <h3>Contact Number</h3>
                        <p class="mb-0">
                            <strong data-testid="about-phone">@(about.ContactPhone ?? "")</strong>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="campo-contact-item">
                    <div class="campo-contact-icon"><i class="fas fa-location-dot"></i></div>
                    <div>
                        <h3>Location</h3>
                        <p class="mb-0">
                            <strong data-testid="about-location">@TurfText(about.Location)</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
</div>
