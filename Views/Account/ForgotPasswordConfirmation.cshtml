@{
    ViewData["Title"] = "Check Your Email";
    var resetLink = TempData["ResetLink"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <i class="fas fa-envelope-open fa-3x text-success mb-3"></i>
                    <h3>Check Your Email</h3>
                    <p>If an account with that email exists, a password reset link has been sent.</p>

                    @if (!string.IsNullOrEmpty(resetLink))
                    {
                        <div class="alert alert-warning text-left mt-3">
                            <strong>Development only:</strong> Email service is not yet configured.
                            Use this link to reset the password:
                            <hr />
                            <a href="@resetLink" class="text-break">@resetLink</a>
                        </div>
                    }

                    <a asp-action="Login" class="btn btn-primary mt-3">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>