<!DOCTYPE html>
@inject CourtBookingSystem.Services.SiteContentService SiteContent
@{
    var ws = await SiteContent.GetSettingsAsync();
    var theme = CourtBookingSystem.Models.Cms.LandingColorSchemeCatalog.GetByKey(ws.LandingColorScheme);
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isAvailabilityPage = string.Equals(currentController, "Availability", StringComparison.OrdinalIgnoreCase);
    var logoSrc = string.IsNullOrWhiteSpace(ws.NavbarLogoPath)
        ? null
        : (ws.NavbarLogoPath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ws.NavbarLogoPath : "/" + ws.NavbarLogoPath);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - @ws.WebsiteName</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- AdminLTE 3 (includes Bootstrap 4) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <!-- App styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --brand-primary: @theme.Primary;
            --brand-primary-dark: @theme.PrimaryDark;
            --brand-accent: @theme.Accent;
            --brand-bg-soft: @theme.BackgroundSoft;
            --brand-text-dark: @theme.TextDark;
            --brand-primary-rgb: @theme.PrimaryRgb;
            --brand-primary-dark-rgb: @theme.PrimaryDarkRgb;
            --brand-accent-rgb: @theme.AccentRgb;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition layout-top-nav" data-color-scheme="@theme.Key">
    <div class="wrapper">
        @await RenderSectionAsync("AnnouncementBar", required: false)

        <!-- ============ NAVBAR ============ -->
        <nav class="main-header navbar navbar-expand-md navbar-dark navbar-primary site-navbar">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand" data-testid="navbar-brand">
                    @if (!string.IsNullOrEmpty(logoSrc))
                    {
                        <img src="@logoSrc" alt="@ws.WebsiteName logo" class="navbar-logo mr-2" data-testid="navbar-logo" />
                    }
                    else
                    {
                        <i class="fas fa-calendar-check mr-2"></i>
                    }
                    <span class="brand-text font-weight-bold">@ws.WebsiteName</span>
                </a>

                <button class="navbar-toggler order-1" type="button" data-toggle="collapse" data-target="#navbarCollapse"
                        aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse order-3" id="navbarCollapse">
                    <ul class="navbar-nav site-navbar-nav">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(isHomePage ? "active" : "")">
                                <i class="fas fa-home"></i>
                                <span>Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Availability" asp-action="Find" class="nav-link @(isAvailabilityPage ? "active" : "")">
                                <i class="fas fa-search-location"></i>
                                <span>Find a Slot</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/#promos" class="nav-link">
                                <i class="fas fa-bullhorn"></i>
                                <span>Promos</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/#about" class="nav-link">
                                <i class="fas fa-circle-info"></i>
                                <span>About</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Right navbar -->
@*                 <ul class="order-1 order-md-3 navbar-nav navbar-no-expand site-navbar-account ml-auto">
                    <partial name="_LoginPartial" />
                </ul> *@
            </div>
        </nav>

        <!-- ============ CONTENT ============ -->
        <div class="content-wrapper" style="margin-left:0;">
            @RenderBody()
        </div>

        <!-- ============ FOOTER ============ -->
        <footer class="main-footer text-sm">
            <strong>&copy; @PhilippineTime.Now.Year <a href="@($"{Context.Request.Scheme}://{Context.Request.Host}/admin")">@ws.WebsiteName</a>.</strong> All rights reserved.
            <span class="d-block d-sm-inline-block float-sm-right mt-3 mt-sm-0">
                Developed by <a href="https://elgenee.github.io/ProfileSite/" target="_blank" rel="noopener noreferrer">EQUIAMC</a>
            </span>
        </footer>
    </div>

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE 3 -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    <!-- App scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
