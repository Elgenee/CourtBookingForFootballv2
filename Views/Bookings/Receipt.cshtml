@model CourtBookingSystem.Models.Booking
@inject CourtBookingSystem.Services.SiteContentService SiteContent
@using CourtBookingSystem.Models.Enums
@{
    Layout = null;
    var ws = await SiteContent.GetSettingsAsync();
    var payment = Model.Payments?.OrderByDescending(p => p.Id).FirstOrDefault();
    var summary = CourtBookingSystem.Services.PaymentSummaryHelper.Calculate(Model);
    var isReservationOnlyPaid = Model.BookingStatus == BookingStatus.PartiallyPaid && summary.RemainingBalance > 0m;
    string formatTime(TimeSpan t) => PhilippineTime.FormatTime(t);

    string statusBadge(BookingStatus s) => s switch
    {
        BookingStatus.Confirmed   => "badge-confirmed",
        BookingStatus.PartiallyPaid => "badge-partial",
        BookingStatus.Pending     => "badge-pending",
        BookingStatus.ForApproval => "badge-forapproval",
        BookingStatus.Cancelled   => "badge-cancelled",
        BookingStatus.Completed   => "badge-completed",
        _ => "badge-pending"
    };
    string payBadge(PaymentStatus? s) => s switch
    {
        PaymentStatus.Approved  => "badge-approved",
        PaymentStatus.Submitted => "badge-submitted",
        PaymentStatus.Rejected  => "badge-cancelled",
        PaymentStatus.Unpaid    => "badge-unpaid",
        _ => "badge-pending"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Receipt @Model.BookingReferenceNo · @ws.WebsiteName</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-testid="receipt-page">
    <div class="receipt-page">
        <div class="receipt-card" data-testid="receipt-card">
            <div class="receipt-header">
                @if (!string.IsNullOrEmpty(ws.NavbarLogoPath))
                {
                    <img src="/@ws.NavbarLogoPath" alt="@ws.WebsiteName" style="max-height:38px; margin-bottom:6px;" />
                }
                <div class="brand">@ws.WebsiteName</div>
                @if (!string.IsNullOrEmpty(ws.WebsiteTagline))
                {
                    <div class="tagline">@ws.WebsiteTagline</div>
                }
            </div>

            <div class="receipt-body">
                <div class="receipt-ref">
                    <span class="label">Booking Reference</span>
                    <span class="value" data-testid="receipt-reference">@Model.BookingReferenceNo</span>
                </div>

                <div class="receipt-row">
                    <span class="label">Customer</span>
                    <span class="value" data-testid="receipt-customer">@Model.CustomerName</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Field</span>
                    <span class="value" data-testid="receipt-court">@Model.Court?.CourtName</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Sport</span>
                    <span class="value" data-testid="receipt-sport">@Model.Court?.SportType</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Date</span>
                    <span class="value" data-testid="receipt-date">@Model.BookingDate.ToString("dddd, MMM d, yyyy")</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Time</span>
                    <span class="value" data-testid="receipt-time">@formatTime(Model.StartTime) – @formatTime(Model.EndTime)</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Booking Status</span>
                    <span class="value">
                        <span class="receipt-badge @statusBadge(Model.BookingStatus)" data-testid="receipt-status">@Model.BookingStatus</span>
                    </span>
                </div>
                <div class="receipt-row">
                    <span class="label">Payment Status</span>
                    <span class="value">
                        @if (payment != null)
                        {
                            <span class="receipt-badge @payBadge(payment.PaymentStatus)" data-testid="receipt-payment-status">@payment.PaymentStatus</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </span>
                </div>
                <div class="receipt-row">
                    <span class="label">Total Amount</span>
                    <span class="value receipt-amount" data-testid="receipt-amount">@summary.TotalAmount.ToString("0.00")</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Amount Paid</span>
                    <span class="value receipt-amount" data-testid="receipt-amount-paid">@summary.AmountPaid.ToString("0.00")</span>
                </div>
                <div class="receipt-row">
                    <span class="label">Remaining Balance</span>
                    <span class="value receipt-amount" data-testid="receipt-remaining-balance">@summary.RemainingBalance.ToString("0.00")</span>
                </div>
            </div>

            @if (isReservationOnlyPaid)
            {
                <div class="alert alert-warning small mt-3 mb-0" data-testid="receipt-reservation-instruction">
                    <i class="fas fa-exclamation-triangle mr-1"></i>
                    <strong>Reservation payment only:</strong>
                    <ol class="mb-0 mt-1 pl-4">
                        <li>Go to the website and open <strong>Find Booking</strong>.</li>
                        <li>Enter your booking reference and mobile number.</li>
                        <li>Pay the remaining balance before your schedule.</li>
                    </ol>
                </div>
            }
            else if (Model.Court?.SportType == SportType.Football && Model.BookingStatus != BookingStatus.Cancelled)
            {
                <div class="alert alert-info small mt-3 mb-0">
                    <i class="fas fa-info-circle mr-1"></i>
                    Payment confirmation of Full Payment will need to be presented before entry into play area.
                    In order to avoid delays, please settle payment before your scheduled booking.
                </div>
            }

            <div class="receipt-actions no-print">
                <button type="button" class="btn btn-primary" onclick="printReceipt();" data-testid="btn-print-receipt">
                    <i class="fas fa-print mr-1"></i> Print Receipt
                </button>
                <a asp-action="ReceiptPdf" asp-route-reference="@Model.BookingReferenceNo" class="btn btn-outline-primary" data-testid="btn-download-pdf">
                    <i class="fas fa-file-pdf mr-1"></i> Download PDF
                </a>
                <a asp-action="Confirmation" asp-route-reference="@Model.BookingReferenceNo" class="btn btn-link" data-testid="btn-back-confirmation">
                    <i class="fas fa-arrow-left mr-1"></i> Back
                </a>
            </div>

            <div class="receipt-footer no-print">
                Tip: on mobile, tap <em>Print Receipt</em> then "Save as PDF" from your browser's print dialog.
            </div>
        </div>
    </div>

    <script>
        function printReceipt() {
            // Cross-browser print — works on Android Chrome + iOS Safari.
            try {
                if (window.print) { window.print(); return; }
            } catch (e) { /* fall through */ }
            // Fallback: send the user to the server-rendered PDF.
            window.location.href = '@Url.Action("ReceiptPdf", "Bookings", new { reference = Model.BookingReferenceNo })';
        }
    </script>
</body>
</html>
