@model CourtBookingSystem.ViewModels.FindBookingViewModel
@{
    ViewData["Title"] = "Find Booking";
}

<section class="section-default">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card booking-card">
                    <div class="card-header">
                        <i class="fas fa-search mr-2"></i>Find Your Booking
                    </div>
                    <div class="card-body">
                        <form asp-action="Find" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="form-group">
                                <label asp-for="BookingReferenceNo"></label>
                                <input asp-for="BookingReferenceNo" class="form-control text-uppercase" placeholder="GFC-YYYYMMDD-XXXXXX"
                                       data-booking-reference-mask autocomplete="off" autocapitalize="characters" spellcheck="false"
                                       maxlength="19" required pattern="[Gg][Ff][Cc]-[0-9]{8}-[A-Za-z0-9]{6}"
                                       aria-describedby="booking-reference-help"
                                       title="Enter GFC-, 8 date digits, a hyphen, and the 6-character booking code." />
                                <small id="booking-reference-help" class="form-text text-muted">Enter the 8-digit date and 6-character code from your booking reference. GFC- and the hyphen are added automatically.</small>
                                <span asp-validation-for="BookingReferenceNo" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="CustomerMobile"></label>
                                <input asp-for="CustomerMobile" class="form-control" placeholder="Mobile number used when booking" autocomplete="tel" />
                                <span asp-validation-for="CustomerMobile" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fas fa-search mr-1"></i>Find Booking
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-reference-mask.js" asp-append-version="true"></script>
}
